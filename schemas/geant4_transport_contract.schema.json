{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hadros3.local/schemas/geant4_transport_contract.schema.json",
  "title": "HADROS3 H3-W11 GEANT4 transport configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "backend",
    "input_source",
    "geometry_model",
    "material",
    "density_source",
    "execution_model",
    "site_workers",
    "density_g_cm3",
    "hydrogen_mass_fraction",
    "patch_half_size_mm",
    "world_margin_mm",
    "physics_list",
    "physics_domain_policy",
    "validated_maximum_energy_gev",
    "production_cut_mm",
    "random_seed",
    "max_events",
    "max_recorded_steps",
    "threads",
    "optical_physics_enabled"
  ],
  "properties": {
    "mode": {"enum": ["disabled", "environment_check", "import_check", "vacuum_smoke", "material_smoke", "real_free"]},
    "backend": {"const": "geant4"},
    "input_source": {"const": "event_generation_hepmc3"},
    "geometry_model": {"const": "local_homogeneous_patch_v1"},
    "material": {"enum": ["HADROS3_H_HE", "G4_WATER", "G4_Pb", "G4_Galactic"]},
    "density_source": {"enum": ["dis_vertex_local", "configured_fixture"]},
    "execution_model": {"const": "per_site_subprocess"},
    "site_workers": {"type": "integer", "minimum": 1},
    "density_g_cm3": {"type": "number", "exclusiveMinimum": 0},
    "hydrogen_mass_fraction": {"type": "number", "minimum": 0, "maximum": 1},
    "patch_half_size_mm": {"type": "number", "exclusiveMinimum": 0},
    "world_margin_mm": {"type": "number", "exclusiveMinimum": 0},
    "physics_list": {"const": "FTFP_BERT"},
    "physics_domain_policy": {"const": "fail_stage"},
    "validated_maximum_energy_gev": {"type": "number", "exclusiveMinimum": 0, "maximum": 100000},
    "production_cut_mm": {"type": "number", "exclusiveMinimum": 0},
    "random_seed": {"type": "integer", "minimum": 1},
    "max_events": {"type": "integer", "minimum": 1},
    "max_recorded_steps": {"type": "integer", "minimum": 1},
    "threads": {"const": 1},
    "optical_physics_enabled": {"const": false}
  }
}
